# Salin ke .env.local (dev) atau /opt/wa-automation/.env (VPS). Jangan pernah di-commit.

# Login dashboard
AUTH_SECRET=                # acak >= 32 karakter: openssl rand -hex 32
ADMIN_EMAIL=                # admin pertama; hanya dipakai saat tabel pengguna masih kosong
ADMIN_PASSWORD=             # minimal 10 karakter

# Hermes (profil cs milik user Linux suka-automation)
HERMES_API_KEY=             # = API_SERVER_KEY di ~suka-automation/.hermes/profiles/cs/.env

# PostgreSQL. Di VPS: salin nilai WA_DATABASE_URL dari /opt/wa-postgres/.env.
# Dev lokal: jalankan `npm run db` (PostgreSQL di ./data/pg), lalu pakai nilai di bawah.
DATABASE_URL=               # postgres://wa:wa@127.0.0.1:5434/wa
# DB_POOL=4                 # koneksi maksimal ke database; default 4

# WhatsApp (Baileys) tidak butuh kunci apa pun: sesi tiap nomor tersimpan di database.
# MAKS_NOMOR=30             # batas jumlah nomor (pengaman memori); default 30

# Hanya untuk dev lokal (di VPS sudah diisi deploy/docker-compose.yml):
# DATA_DIR=./data           # hanya dibaca sekali: wa.db lama (SQLite) di sini diimpor ke PostgreSQL
# HERMES_API_URL=http://127.0.0.1:8644
# HERMES_PROFILE=cs

# Sinkron otomatis menu, harga, promo, dan outlet dari database kasir Suka Shawarma (opsional):
# SINKRON_SS_URL=           # https://<project-ref>.supabase.co
# SINKRON_SS_APIKEY=        # kunci publishable/anon Supabase
# SINKRON_SS_KUNCI=         # kunci rahasia kb_cs_ambil (hash SHA-256 disimpan di kb_cs.pengaturan.kunci_hash)
# SINKRON_SS_RAHASIA=       # rahasia HMAC-SHA256 sinyal ping (disimpan di vault Supabase kb_cs_rahasia_ping)

