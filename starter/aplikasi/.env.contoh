# Salin berkas ini menjadi .env.local lalu isi nilainya. JANGAN commit .env.local.

# Alamat mesin ChatGerCep (tanpa /api/v1). Sandbox bawaan: http://localhost:1975
CHATGERCEP_ALAMAT=http://localhost:1975

# API key dari portal Developer: cg_test_... (sandbox) atau cg_live_... (production). Hanya dipakai di server.
CHATGERCEP_KEY=

# Rahasia penanda tangan webhook (whsec_...). Didapat SEKALI saat mendaftarkan webhook di halaman /pengaturan.
CHATGERCEP_RAHASIA_WEBHOOK=

# Alamat aplikasi ini SEPERTI DILIHAT MESIN (dipakai untuk URL webhook: <alamat>/api/webhook).
# Mesin berjalan di Docker di komputer yang sama? Pakai http://host.docker.internal:3000
ALAMAT_APLIKASI=http://localhost:3000
