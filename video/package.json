{
  "name": "wa-motion",
  "private": true,
  "description": "Video motion graphic promosi ChatGercep (Remotion, 25 dtk, bahasa Inggris). Terpisah dari app: tidak ikut build/deploy. Termasuk video demo produk (src/demo, 1080p 60fps, tampilan UI asli): npm run demo:render.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Promo out/whatsapp-automation-promo.mp4 --codec=h264 --crf=16",
    "demo:studio": "remotion studio src/demo/index.ts --config=remotion.demo.config.ts",
    "demo:render": "remotion render src/demo/index.ts Demo out/demo-chatgercep.mp4 --config=remotion.demo.config.ts --codec=h264 --crf=17 --gl=angle",
    "demo:render:vertikal": "remotion render src/demo/index.ts DemoVertikal out/demo-chatgercep-vertikal.mp4 --config=remotion.demo.config.ts --codec=h264 --crf=16 --image-format=png --gl=angle",
    "konten:render": "remotion render src/index.ts KontenHook out/konten-hook-rp250rb.mp4 --codec=h264 --crf=17 --gl=angle",
    "soft:e1:render": "remotion render src/index.ts SoftE1 out/soft-e1-kamus-chat.mp4 --codec=h264 --crf=17 --gl=angle"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.2.8",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@remotion/cli": "4.0.535",
    "@remotion/tailwind-v4": "^4.0.535",
    "lucide-react": "^1.67.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.535",
    "tailwindcss": "^4.3.4",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
